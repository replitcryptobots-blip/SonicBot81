# ════════════════════════════════════════════════════════════
# SONIC MEV ARBITRAGE BOT - CONFIGURATION
# ════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values
# NEVER commit .env with real keys!

# ════════════════════════════════════════════════════════════
# NETWORK CONFIGURATION
# ════════════════════════════════════════════════════════════

# Sonic Chain ID (must be 146 for Sonic mainnet)
CHAIN_ID=146

# RPC Endpoints (comma-separated for failover)
# Find official RPCs: https://docs.soniclabs.com/
RPC_URL=https://rpc.soniclabs.com,https://rpc.sonic.fantom.network

# WebSocket RPC (optional, for faster block monitoring)
# Leave empty to use polling
WS_RPC_URL=

# ════════════════════════════════════════════════════════════
# WALLET CONFIGURATION
# ════════════════════════════════════════════════════════════

# Private key (WITHOUT 0x prefix)
# WARNING: Keep this SECRET! Use a dedicated wallet for the bot.
PRIVATE_KEY=your_private_key_here

# ════════════════════════════════════════════════════════════
# SAFETY CONTROLS (CRITICAL!)
# ════════════════════════════════════════════════════════════

# DRY_RUN: If true, simulates trades but NEVER sends transactions
# ALWAYS test in dry-run first!
DRY_RUN=true

# LIVE_MODE: Must be explicitly set to true for real trading
LIVE_MODE=false

# I_UNDERSTAND_RISKS: Final safety check - must be true for live trading
# By setting this to true, you acknowledge:
# - You can lose funds
# - Smart contract risks exist
# - Gas costs are real
# - No guarantees of profit
I_UNDERSTAND_RISKS=false

# KILL_SWITCH: Set to true to immediately halt all operations
KILL_SWITCH=false

# ════════════════════════════════════════════════════════════
# FLASHLOAN PROVIDER
# ════════════════════════════════════════════════════════════

# Flashloan provider contract address
# MUST BE VERIFIED ON-CHAIN! See verification checklist in README
# Options on Sonic:
# - Balancer-style vaults
# - Aave-style pools
# - DEX-native flashloans
# Leave empty to skip flashloan validation in dry-run
FLASHLOAN_PROVIDER=

# Flashloan fee in basis points (e.g., 5 = 0.05%)
# Verify this on-chain! Do NOT guess!
FLASHLOAN_FEE_BPS=5

# ════════════════════════════════════════════════════════════
# DEX CONFIGURATION
# ════════════════════════════════════════════════════════════

# DEX 1 (e.g., SwapX, SonicSwap)
# Router contract address - MUST BE VERIFIED!
DEX1_NAME=DEX1
DEX1_ROUTER=
DEX1_FACTORY=
DEX1_FEE_BPS=30

# DEX 2
DEX2_NAME=DEX2
DEX2_ROUTER=
DEX2_FACTORY=
DEX2_FEE_BPS=30

# ════════════════════════════════════════════════════════════
# TOKEN WATCHLIST
# ════════════════════════════════════════════════════════════

# Tokens to monitor (comma-separated addresses)
# Start with liquid pairs: WETH, USDC, stablecoins
# Verify addresses on Sonic block explorer!
WATCH_TOKENS=

# Base token for profit calculation (usually WETH or stable)
BASE_TOKEN=

# ════════════════════════════════════════════════════════════
# PROFITABILITY THRESHOLDS
# ════════════════════════════════════════════════════════════

# Minimum net profit in base token (after all fees)
# e.g., 0.001 WETH
MIN_NET_PROFIT=0.001

# Minimum net profit in basis points (relative)
# e.g., 50 = 0.5% net profit minimum
MIN_NET_PROFIT_BPS=50

# Maximum slippage tolerance in basis points
# e.g., 50 = 0.5% max slippage
MAX_SLIPPAGE_BPS=50

# Maximum gas price in gwei (reject if higher)
MAX_GAS_GWEI=100

# Maximum gas cost in USD (requires price oracle)
MAX_GAS_USD=5

# Maximum trade size in base token
MAX_TRADE_SIZE=10

# ════════════════════════════════════════════════════════════
# CIRCUIT BREAKER
# ════════════════════════════════════════════════════════════

# Stop trading after N consecutive failures
MAX_CONSECUTIVE_FAILURES=5

# Cooldown period after circuit breaker (seconds)
CIRCUIT_BREAKER_COOLDOWN=300

# ════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ════════════════════════════════════════════════════════════

# Block polling interval (ms) - used if WebSocket unavailable
BLOCK_POLL_INTERVAL=2000

# RPC request timeout (ms)
RPC_TIMEOUT=10000

# Maximum concurrent RPC requests (keep low for Termux)
MAX_CONCURRENT_REQUESTS=3

# Rate limit: max requests per second
MAX_REQUESTS_PER_SECOND=10

# ════════════════════════════════════════════════════════════
# LOGGING
# ════════════════════════════════════════════════════════════

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Pretty print logs (set false for production JSON logs)
LOG_PRETTY=true

# Log file path
LOG_FILE=logs/bot.jsonl

# State persistence file
STATE_FILE=state.json

# Trade history file (append-only)
TRADES_FILE=trades.jsonl
