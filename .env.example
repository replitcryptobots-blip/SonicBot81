# ════════════════════════════════════════════════════════════
# SONIC MEV ARBITRAGE BOT - CONFIGURATION
# ════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values
# NEVER commit .env with real keys!
#
# SONIC MAINNET: Chain ID 146
# Verify all addresses on Sonic block explorer before use!
# ════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════
# NETWORK CONFIGURATION
# ════════════════════════════════════════════════════════════

# Sonic Chain ID - MUST be 146 for Sonic mainnet
# Bot will refuse to start if this doesn't match RPC
CHAIN_ID=146

# RPC Endpoints (comma-separated for failover)
# Official Sonic RPCs: https://docs.soniclabs.com/
# Do NOT invent URLs - verify they exist!
RPC_URL=https://rpc.soniclabs.com

# WebSocket RPC (optional, for faster block monitoring)
# Leave empty to use polling instead
WS_RPC_URL=

# ════════════════════════════════════════════════════════════
# WALLET CONFIGURATION
# ════════════════════════════════════════════════════════════

# Private key (WITHOUT 0x prefix)
# WARNING: Keep this SECRET! Use a dedicated wallet for the bot.
# NEVER share or commit this value!
PRIVATE_KEY=your_private_key_here

# ════════════════════════════════════════════════════════════
# SAFETY CONTROLS (CRITICAL!)
# ════════════════════════════════════════════════════════════

# DRY_RUN: If true, simulates trades but NEVER sends transactions
# ALWAYS test in dry-run first! Default: true (SAFE)
DRY_RUN=true

# LIVE_MODE: Must be explicitly set to true for real trading
# Default: false (SAFE)
LIVE_MODE=false

# I_UNDERSTAND_RISKS: Final safety check - must be true for live trading
# By setting this to true, you acknowledge:
# - You can lose funds
# - Smart contract risks exist
# - Gas costs are real
# - No guarantees of profit
# Default: false (SAFE)
I_UNDERSTAND_RISKS=false

# KILL_SWITCH: Set to true to immediately halt all operations
# Use in emergencies! Default: false
KILL_SWITCH=false

# ════════════════════════════════════════════════════════════
# FLASHLOAN PROVIDER (CRITICAL - Sonic-specific)
# ════════════════════════════════════════════════════════════

# FLASHLOAN_TYPE: Which flashloan provider to use
# Options:
#   none     - No flashloan (dry-run only)
#   balancer - Balancer-style Vault (receiveFlashLoan callback)
#   aave     - Aave V3-style Pool (executeOperation callback)
#
# IMPORTANT: You MUST verify which providers exist on Sonic!
# Do NOT guess addresses! Check on-chain before setting.
# If unsure, keep as 'none' and run in DRY_RUN mode.
FLASHLOAN_TYPE=none

# Flashloan provider contract address
# For Balancer: Vault address
# For Aave: Pool address
# MUST BE VERIFIED ON-CHAIN! Leave empty if FLASHLOAN_TYPE=none
FLASHLOAN_PROVIDER=

# Flashloan fee in basis points
# Balancer: typically 0 (free)
# Aave: typically 5-9 bps (0.05%-0.09%)
# VERIFY ON-CHAIN! Do NOT guess!
FLASHLOAN_FEE_BPS=0

# Flashloan receiver contract address
# This is YOUR deployed FlashloanArbitrage.sol contract
# REQUIRED for LIVE_MODE! Deploy it first, then set this address.
# See contracts/FlashloanArbitrage.sol for deployment instructions
FLASHLOAN_RECEIVER_CONTRACT=

# Balancer-specific: Pool ID (optional, for weighted pools)
# Must be 32 bytes: 0x + 64 hex characters
# Leave empty for most Balancer flashloans
FLASHLOAN_POOL_ID=

# ════════════════════════════════════════════════════════════
# DEX CONFIGURATION (Sonic-specific)
# ════════════════════════════════════════════════════════════
# DO NOT INVENT ADDRESSES! Verify on Sonic block explorer!
# Common Sonic DEXes may include: SpookySwap, SwapX, etc.
# Check https://docs.soniclabs.com/ for official DEX integrations

# DEX 1 (e.g., SpookySwap, SwapX)
DEX1_NAME=DEX1
# Router contract address - MUST BE VERIFIED!
DEX1_ROUTER=
# Factory contract address (optional, for pair discovery)
DEX1_FACTORY=
# Fee in basis points (30 = 0.3% for Uniswap V2 style)
DEX1_FEE_BPS=30

# DEX 2
DEX2_NAME=DEX2
DEX2_ROUTER=
DEX2_FACTORY=
DEX2_FEE_BPS=30

# ════════════════════════════════════════════════════════════
# TOKEN WATCHLIST (Sonic-specific)
# ════════════════════════════════════════════════════════════
# DO NOT INVENT ADDRESSES! Verify on Sonic block explorer!

# Tokens to monitor (comma-separated addresses)
# Start with liquid pairs: WETH, USDC, stablecoins on Sonic
# Example: 0xabc...,0xdef...,0x123...
WATCH_TOKENS=

# Base token for profit calculation (usually WETH or stable)
# This is the token you'll receive profits in
BASE_TOKEN=

# ════════════════════════════════════════════════════════════
# PROFITABILITY THRESHOLDS
# ════════════════════════════════════════════════════════════

# Minimum net profit in base token (after all fees)
# e.g., 0.001 means 0.001 of base token minimum
MIN_NET_PROFIT=0.001

# Minimum net profit in basis points (relative to trade size)
# e.g., 50 = 0.5% net profit minimum
MIN_NET_PROFIT_BPS=50

# Maximum slippage tolerance in basis points
# e.g., 50 = 0.5% max slippage
MAX_SLIPPAGE_BPS=50

# Maximum gas price in gwei (reject opportunities if higher)
MAX_GAS_GWEI=100

# Maximum gas cost in USD (requires price oracle - future feature)
MAX_GAS_USD=5

# Maximum trade size in base token
MAX_TRADE_SIZE=10

# Gas estimate buffer percentage (adds safety margin)
# e.g., 20 = 20% buffer on top of base estimate
GAS_ESTIMATE_BUFFER_PERCENT=20

# ════════════════════════════════════════════════════════════
# CIRCUIT BREAKER
# ════════════════════════════════════════════════════════════

# Stop trading after N consecutive failures
MAX_CONSECUTIVE_FAILURES=5

# Cooldown period after circuit breaker trips (seconds)
CIRCUIT_BREAKER_COOLDOWN=300

# ════════════════════════════════════════════════════════════
# PERFORMANCE TUNING (Termux-optimized)
# ════════════════════════════════════════════════════════════

# Block polling interval (ms) - used if WebSocket unavailable
# Lower = faster detection but more RPC calls
BLOCK_POLL_INTERVAL=2000

# RPC request timeout (ms)
RPC_TIMEOUT=10000

# Maximum concurrent RPC requests (keep low for Termux/mobile)
MAX_CONCURRENT_REQUESTS=3

# Rate limit: max requests per second
MAX_REQUESTS_PER_SECOND=10

# Transaction confirmation timeout (ms)
TX_CONFIRMATION_TIMEOUT=60000

# Transaction receipt poll interval (ms)
TX_POLL_INTERVAL=1000

# ════════════════════════════════════════════════════════════
# LOGGING
# ════════════════════════════════════════════════════════════

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Pretty print logs (set false for production JSON logs)
LOG_PRETTY=true

# Log file path (JSONL format for easy parsing)
LOG_FILE=logs/bot.jsonl

# State persistence file
STATE_FILE=state.json

# Trade history file (append-only JSONL)
TRADES_FILE=trades.jsonl
